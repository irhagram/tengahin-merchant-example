# ─────────────────────────────────────────────────────────────
# Salin file ini menjadi ".env" lalu isi nilainya.
# CATATAN: kamu TIDAK wajib membuat .env manual. Jalankan `npm start`, buka
# http://localhost:4000 dan halaman setup akan membuatkan file .env untukmu.
# ─────────────────────────────────────────────────────────────

# API key dari Tengahin → Merchant → tab "API" → "Buat kunci" (diawali tgk_).
# RAHASIA: jangan di-commit ke git, jangan dikirim ke browser.
TENGAHIN_API_KEY=

# Alamat server Tengahin, tanpa garis miring di akhir.
TENGAHIN_BASE_URL=https://tengah.in

# (Opsional) Secret webhook dari Merchant → tab "Webhook" (diawali whsec_).
# URL webhook yang diisi di Tengahin: https://DOMAIN-KAMU/webhooks/tengahin
TENGAHIN_WEBHOOK_SECRET=

# Hash kata sandi admin + rahasia sesi. Dibuat otomatis oleh halaman setup.
# Kalau mengisi manual: ADMIN_PASSWORD_HASH didapat dari `node -e "import('./src/auth.js').then(m=>console.log(m.hashPassword('kata-sandi-kamu')))"`
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Port server (bawaan 4000) dan batas ukuran file upload dalam MB (bawaan 50)
PORT=4000
MAX_UPLOAD_MB=50
